<Window x:Class="lab_5.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Інвентарна відомість іграшок" Height="600" Width="900">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Vertical" Margin="0,0,0,10">
            <TextBlock Text="Додати іграшку" FontWeight="Bold" FontSize="14" Margin="5"/>
            <Grid Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Назва:" VerticalAlignment="Center" Margin="5"/>
                <TextBox x:Name="TitleTextBox" Grid.Row="0" Grid.Column="1" Margin="5" Padding="2"/>

                <TextBlock Grid.Row="0" Grid.Column="2" Text="Вартість (грн):" VerticalAlignment="Center" Margin="5"/>
                <TextBox x:Name="CostTextBox" Grid.Row="0" Grid.Column="3" Margin="5" Padding="2"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Вік від:" VerticalAlignment="Center" Margin="5"/>
                <TextBox x:Name="MinAgeTextBox" Grid.Row="1" Grid.Column="1" Margin="5" Padding="2"/>

                <TextBlock Grid.Row="1" Grid.Column="2" Text="Вік до:" VerticalAlignment="Center" Margin="5"/>
                <TextBox x:Name="MaxAgeTextBox" Grid.Row="1" Grid.Column="3" Margin="5" Padding="2"/>
            </Grid>
            <Button x:Name="AddButton" Content="Додати іграшку" Margin="5" Padding="5" Click="AddButton_Click"/>
        </StackPanel>

        <DataGrid x:Name="ToysDataGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,5,0,5">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Назва іграшки" Binding="{Binding Title}" Width="*"/>
                <DataGridTextColumn Header="Вартість (грн)" Binding="{Binding Cost}" Width="120"/>
                <DataGridTextColumn Header="Вік від (років)" Binding="{Binding MinAge}" Width="100"/>
                <DataGridTextColumn Header="Вік до (років)" Binding="{Binding MaxAge}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="5">
            <TextBlock Text="Вік від N:" VerticalAlignment="Center" Margin="5"/>
            <TextBox x:Name="FilterNTextBox" Width="40" Margin="5" VerticalAlignment="Center"/>
            <TextBlock Text="до M:" VerticalAlignment="Center" Margin="5"/>
            <TextBox x:Name="FilterMTextBox" Width="40" Margin="5" VerticalAlignment="Center"/>
            <Button x:Name="FilterButton" Content="Фільтр" Margin="5" Click="FilterButton_Click"/>
            <Button x:Name="DeleteButton" Content="Видалити" Margin="5" Click="DeleteButton_Click"/>
            <Button x:Name="SortButton" Content="Сортувати за вартістю" Margin="5" Click="SortButton_Click"/>
            <Button x:Name="LoadButton" Content="Завантажити" Margin="5" Click="LoadButton_Click"/>
            <Button x:Name="SaveButton" Content="Зберегти" Margin="5" Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
