<Window x:Class="lab_4.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:lab_4"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <ComboBox x:Name="ArtTypeComboBox" HorizontalAlignment="Left" Margin="30,30,0,0" VerticalAlignment="Top" Width="150" SelectionChanged="ArtTypeComboBox_SelectionChanged"/>

        <Label Content="Назва:" HorizontalAlignment="Left" Margin="30,70,0,0" VerticalAlignment="Top"/>
        <Label Content="Рік створення:" HorizontalAlignment="Left" Margin="30,110,0,0" VerticalAlignment="Top"/>
        <Label Content="Автор:" HorizontalAlignment="Left" Margin="30,150,0,0" VerticalAlignment="Top"/>
        <Label Content="Вартість:" HorizontalAlignment="Left" Margin="30,190,0,0" VerticalAlignment="Top"/>
        <Label x:Name="SpecificFieldLabel" Content="Техніка:" HorizontalAlignment="Left" Margin="30,230,0,0" VerticalAlignment="Top"/>

        <TextBox x:Name="TitleTextBox" HorizontalAlignment="Left" Margin="150,75,0,0" VerticalAlignment="Top" Width="150"/>
        <TextBox x:Name="YearTextBox" HorizontalAlignment="Left" Margin="150,115,0,0" VerticalAlignment="Top" Width="150"/>
        <TextBox x:Name="AuthorTextBox" HorizontalAlignment="Left" Margin="150,155,0,0" VerticalAlignment="Top" Width="150"/>
        <TextBox x:Name="ValueTextBox" HorizontalAlignment="Left" Margin="150,195,0,0" VerticalAlignment="Top" Width="150"/>
        <TextBox x:Name="SpecificTextBox" HorizontalAlignment="Left" Margin="150,235,0,0" VerticalAlignment="Top" Width="150"/>

        <Button x:Name="AddButton" Content="Додати в колекцію" HorizontalAlignment="Left" Margin="30,280,0,0" VerticalAlignment="Top" Width="270" Height="30" Click="AddButton_Click"/>

        <ListBox x:Name="ArtListBox" Margin="350,30,30,100"/>

        <TextBlock x:Name="TotalValueTextBlock" Text="Загальна вартість творів до 1900 року: 0" HorizontalAlignment="Left" Margin="350,350,0,0" VerticalAlignment="Top" FontSize="14" FontWeight="Bold"/>

        <TextBlock x:Name="TotalInsuranceTextBlock" Text="Загальна вартість страхування: 0" HorizontalAlignment="Left" Margin="350,380,0,0" VerticalAlignment="Top" FontSize="14" FontWeight="Bold" Foreground="DarkBlue"/>

    </Grid>
</Window>
